# --- Serveur API ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=qiao
# Hébergeur : DATABASE_URL remplace les paramètres ci-dessus (DB_SSL=true pour une base externe).
# Crée / met à jour automatiquement les tables (développement uniquement ; false par défaut en production)
DB_SYNC=true
# Applique les migrations au démarrage (true par défaut en production, voir DEPLOY.md)
DB_MIGRATE=false
# Remplit les tables vides avec le catalogue de départ au premier démarrage
DB_SEED=true
# Compte de démonstration et membres fictifs de Community (true par défaut en local, false par défaut en production)
SEED_DEMO=true

# --- Fichiers téléversés ---
# Dossier des supports de formation et pièces jointes : disque persistant en production (défaut : ./uploads)
UPLOADS_DIR=

# --- Authentification ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- Site public (liens des e-mails et retours WeChat / Facebook) ---
PUBLIC_URL=http://localhost:3000

# --- Certificats QIAO Academy (lien de vérification : <PUBLIC_URL>/?tab=certificat&numero=…) ---
# Police TTF/OTF facultative pour les noms hors alphabet latin (ex. Noto Sans SC pour le chinois) ;
# sans elle, seuls les caractères latins du nom figurent sur le PDF (la page de vérification affiche le nom complet).
ACADEMY_CERTIFICATE_FONT=

# --- Administrateur QIAO Community (créé ou promu au démarrage) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur QIAO

# --- Connexion WeChat (Open Platform, QR Connect) / Facebook Login ---
# URL de retour à déclarer chez le fournisseur : <PUBLIC_URL>/api/auth/oauth/<wechat|facebook>/callback
# Sans identifiants, OAUTH_MOCK=true active un simulateur local (ignoré si NODE_ENV=production).
OAUTH_MOCK=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- E-mails (réinitialisation de mot de passe) : sans SMTP, le lien est écrit dans les journaux ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QIAO <no-reply@qiao.tn>

# --- Services & paiements sécurisés ---
# Prestataire de paiement agréé qui encaisse, retient puis rembourse ou verse les fonds (QIAO ne détient jamais les fonds).
# « stripe » = Stripe Connect (charges et transferts séparés, versements manuels) ;
# « sandbox » = simulateur local (défaut hors production, refusé en production). Sans prestataire en production : paiement désactivé.
PAYMENT_PROVIDER=sandbox
# Secret de signature des notifications du simulateur (sandbox uniquement ; dérivé de JWT_SECRET s'il est vide).
PAYMENT_WEBHOOK_SECRET=

# --- Stripe Connect (PAYMENT_PROVIDER=stripe) ---
# Prérequis : Connect activé sur le compte Stripe (profil de plateforme complété), comptes connectés de type Express.
# Clé secrète (sk_test_… en test, sk_live_… en production) ou clé restreinte (rk_…) : Dashboard > Développeurs > Clés API.
STRIPE_SECRET_KEY=
# Secret(s) de signature des webhooks (whsec_…), séparés par des virgules. Point d'entrée à déclarer chez Stripe :
#   <URL publique de l'API>/api/payments/webhooks/stripe
# avec DEUX destinations : « Votre compte » (checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, refund.created, refund.updated, refund.failed, charge.refund.updated)
# et « Comptes connectés » (account.updated, payout.paid, payout.failed, payout.canceled) — un secret par destination.
# En local : stripe listen --forward-to localhost:4000/api/payments/webhooks/stripe --forward-connect-to localhost:4000/api/payments/webhooks/stripe
# (affiche le secret whsec_… à reporter ici). Sans secret, les notifications sont refusées et seul le rapprochement périodique suit les opérations.
STRIPE_WEBHOOK_SECRET=
# Pays des comptes de versement des prestataires (comptes Express). Transferts transfrontaliers : uniquement entre
# États-Unis, Canada, Royaume-Uni, EEE et Suisse ; sinon plateforme et prestataires doivent être dans la même région.
STRIPE_CONNECT_COUNTRY=FR
# Accord de service des comptes connectés : « full » (défaut) ou « recipient » (versements uniquement, pays éligibles).
STRIPE_CONNECT_SERVICE_AGREEMENT=full
# Moyens de paiement proposés sur la page Stripe Checkout (séparés par des virgules).
STRIPE_PAYMENT_METHOD_TYPES=card
# Version d'API Stripe épinglée (défaut 2024-06-20).
STRIPE_API_VERSION=
# Version des API v2 (création des comptes prestataires, Accounts v2 ; défaut 2026-09-30.endive).
STRIPE_API_V2_VERSION=
# Commission QIAO en % du montant libéré au prestataire (figée sur chaque transaction à l'acceptation).
PAYMENT_COMMISSION_PERCENT=10
# Fréquence des traitements périodiques (échéances, rappels, rapprochement), en millisecondes.
PAYMENT_SCHEDULER_INTERVAL_MS=30000
# Tests uniquement (sandbox, hors production) : durée de la période de protection en minutes au lieu de 5 jours.
PAYMENT_SANDBOX_PROTECTION_MINUTES=
# Délai de réponse simulé du prestataire de paiement pour les remboursements et versements (ms).
PAYMENT_SANDBOX_DELAY_MS=4000

# --- Messagerie via le compte officiel WeChat QIAO (compte de service vérifié, 服务号) ---
# Les messages privés QIAO sont transmis dans WeChat aux membres qui ont lié leur compte (QR code), et leurs réponses
# tapées dans WeChat sont publiées dans la conversation QIAO.
# Back-office du compte officiel > Paramètres et développement > Configuration de base :
#   AppID / AppSecret ci-dessous, liste blanche IP (IP du serveur QIAO), et « Configuration du serveur » :
#   URL = <URL publique de l'API>/api/wechat/oa/callback, Token = WECHAT_OA_TOKEN,
#   EncodingAESKey = WECHAT_OA_ENCODING_AES_KEY (mode sécurisé recommandé).
WECHAT_OA_APP_ID=
WECHAT_OA_APP_SECRET=
WECHAT_OA_TOKEN=
WECHAT_OA_ENCODING_AES_KEY=
# Notification modèle (模板消息) envoyée hors de la fenêtre de 48 h : identifiant du modèle choisi et correspondance
# de ses champs (title = titre, summary = aperçu, time = date), par ex. thing1:title,thing2:summary,time3:time
WECHAT_OA_TEMPLATE_ID=
WECHAT_OA_TEMPLATE_FIELDS=thing1:title,thing2:summary,time3:time
# Sans compte officiel configuré, un simulateur est actif hors production (/api/wechat/simulator) ; false pour le couper.
WECHAT_OA_MOCK=true

# Assistant SEO / GEO des formulaires d'administration (API Gemini, clé serveur uniquement).
GEMINI_API_KEY=
# Modèles essayés dans l'ordre (repli automatique si l'un est hors quota ou saturé).
GEMINI_MODELS=gemini-4-argon,gemini-3.5-flash-lite,gemini-2.5-flash
