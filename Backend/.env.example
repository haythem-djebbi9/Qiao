# --- Serveur API ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=qiao
# Crée / met à jour automatiquement les tables (développement)
DB_SYNC=true
# Remplit la base avec les données du template au premier démarrage
DB_SEED=true

# --- Authentification ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
