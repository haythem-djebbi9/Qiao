# Aucune variable n'est nécessaire en production : l'API sert le site et répond sous /api sur la même adresse.

# Site et API sur deux adresses distinctes (facultatif, à décommenter) :
# VITE_API_URL=https://api.exemple.com/api

# Développement uniquement : serveur vers lequel Vite relaie /api (défaut http://localhost:4000).
# VITE_API_PROXY=http://localhost:4000
